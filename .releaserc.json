{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun scripts/build-extension.ts --version ${nextRelease.version} --zip"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "regie-extension.zip", "label": "Regie extension (Chrome, unzip and load unpacked)" }]
      }
    ]
  ]
}
