{
  "manifest_version": 3,
  "name": "Regie relay",
  "version": "0.0.0",
  "description": "Plays Twitch without ads, in Regie (the way the Regie relay does, with no server to run) and on twitch.tv itself.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://usher.ttvnw.net/*",
    "https://*.ttvnw.net/*",
    "https://*.playlist.ttvnw.net/*",
    "https://*.cloudfront.net/*",
    "https://maxgfr.github.io/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://maxgfr.github.io/regie/*", "http://localhost:5173/*", "http://localhost:4173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://player.twitch.tv/*"],
      "js": ["twitch-visible.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.twitch.tv/*", "https://m.twitch.tv/*"],
      "js": ["twitch-site.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "cors", "enabled": true, "path": "rules.json" }]
  }
}
