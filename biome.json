{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!dist", "!node_modules", "!playwright-report", "!test-results", "!.impeccable"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "css": { "parser": { "cssModules": false } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": { "noDangerouslySetInnerHtml": "error" }
    }
  }
}
